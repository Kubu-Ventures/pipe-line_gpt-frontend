NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side API address (sign-in). Defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://localhost:8000
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Show one-click demo account buttons on the login page (demo deployments only;
# the backend must also run with DEMO_MODE=true)
NEXT_PUBLIC_DEMO_MODE=false
